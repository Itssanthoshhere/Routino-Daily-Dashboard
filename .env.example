# ==========================================
# Schedino - Environment Config
# ==========================================

# --- Application Branding & Customization ---
NEXT_PUBLIC_APP_NAME=Schedino
NEXT_PUBLIC_APP_TAGLINE=Your schedule, routine, and focus in one
NEXT_PUBLIC_USER_NAME=Santhosh
NEXT_PUBLIC_USER_INITIAL=S
NEXT_PUBLIC_DEFAULT_FOCUS_MINUTES=90

# --- Default External Service URLs ---
NEXT_PUBLIC_CALENDAR_URL=https://calendar.google.com
NEXT_PUBLIC_MAIL_URL=https://mail.google.com

# --- Google OAuth Credentials (Required for Google Calendar & Gmail Sync) ---
# Obtain these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# --- NextAuth / Auth.js Configuration ---
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-generated-secret-key-at-least-32-chars
AUTH_SECRET=your-random-generated-secret-key-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000
