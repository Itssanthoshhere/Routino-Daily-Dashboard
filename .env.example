# ==========================================
# Routino - Environment Config
# ==========================================

# --- Application Branding & Customization ---
NEXT_PUBLIC_APP_NAME=Routino
NEXT_PUBLIC_APP_TAGLINE=Your daily routine, schedule, and focus in one
NEXT_PUBLIC_USER_NAME=Santhosh
NEXT_PUBLIC_USER_INITIAL=S
NEXT_PUBLIC_DEFAULT_FOCUS_MINUTES=90

# --- Default External Service URLs ---
NEXT_PUBLIC_CALENDAR_URL=https://calendar.google.com
NEXT_PUBLIC_MAIL_URL=https://mail.google.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/Itssanthoshhere
NEXT_PUBLIC_PORTFOLIO_URL=https://santhosh-vs-portfolio.vercel.app/
NEXT_PUBLIC_DRIVE_URL=https://drive.google.com/drive/my-drive

# --- Google OAuth Credentials (Calendar, Gmail & Drive file metadata) ---
# Obtain these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# --- NextAuth / Auth.js Configuration ---
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-generated-secret-key-at-least-32-chars
AUTH_SECRET=your-random-generated-secret-key-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# --- Optional Microsoft Outlook Integration (Mail & Calendar via Graph API) ---
# Obtain from Azure Portal (Microsoft Entra ID -> App registrations):
# Scopes used: offline_access, User.Read, Mail.Read, Calendars.Read
# Callback URI: http://localhost:3000/api/outlook/callback (or your production Vercel URL)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:3000/api/outlook/callback

# --- Cloud Database Persistence (Optional - for cross-device sync on Vercel) ---
# Neon Postgres (preferred durable option; Vercel Marketplace provides DATABASE_URL):
# DATABASE_URL=postgresql://...
# Create a free Redis instance on Upstash (https://upstash.com) or Vercel KV:
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Alternatively, Vercel KV credentials:
# KV_REST_API_URL=https://your-kv.vercel-storage.com
# KV_REST_API_TOKEN=your-vercel-kv-token

# --- Google Sheets Trackers Sync (Optional) ---
# Private Google Sheet ID (from URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
# Leave blank to use built-in offline demo seed data
TRACKERS_SPREADSHEET_ID=
NEXT_PUBLIC_TRACKERS_SPREADSHEET_ID=
